# ============================================================
# MySQL
# ============================================================

MYSQL_DATABASE=employee_management_db

MYSQL_USER=ems_user

# Replace both passwords on the Oracle server.
#
# Avoid using spaces or the dollar symbol in these values
# because Docker Compose performs variable substitution.
MYSQL_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD

MYSQL_ROOT_PASSWORD=CHANGE_THIS_ROOT_PASSWORD


# ============================================================
# JWT
# ============================================================

# Replace with a Base64-encoded random secret.
APPLICATION_SECURITY_JWT_SECRET_KEY=CHANGE_THIS_BASE64_JWT_SECRET

# Access token validity: 24 hours in milliseconds.
APPLICATION_SECURITY_JWT_ACCESS_TOKEN_EXPIRATION=86400000


# ============================================================
# Initial administrator
# ============================================================

APPLICATION_BOOTSTRAP_ADMIN_USERNAME=admin

APPLICATION_BOOTSTRAP_ADMIN_EMAIL=replace-with-your-email@example.com

APPLICATION_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD